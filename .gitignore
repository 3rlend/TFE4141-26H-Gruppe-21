# ==========================================
# Vivado Generated Directories & Files
# ==========================================

# Temporary build, run, and log files
*.log
*.jou
*.str
*.pb
*.jou
*.wbf
*.wdb

# Vivado project work directories
/.Xil/
/*.runs/
/*.sim/
/*.hw/
/*.ip_user_files/
/*.cache/
/*.gen/

# SDK/Vitis exported workspace directory
/*.sdk/
/*.vitis/

